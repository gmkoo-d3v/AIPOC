@startuml
!pragma layout smetana
top to bottom direction
skinparam defaultFontName NanumGothic
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #64748B
skinparam rectangle {
  BorderColor #5880A8
  BackgroundColor #F0F7FF
}
title Target Personas — 독자에 맞춘 생성·평가 프롬프트 정책
rectangle "원문 + 대상 독자 선택\nTargetOptimizer" as Input #EAF4EF
together {
  rectangle "PUBLIC · 일반인\ngeneral_public\n친근한 과학 해설자\n일상 비유·짧은 문장·전문용어 배제\n프롬프트 복잡도 기준: 0.3" as Public #EDF8F0
  rectangle "STUDENT · 대학생\nuniversity_student\n대학 강의자\n개념 → 정의 → 예시\n프롬프트 복잡도 기준: 0.5" as Student #EEF5FF
  rectangle "WORKER · 실무자\npractitioner\n컨설턴트·전략 분석가\n업무 용어·행동 중심 요약\n프롬프트 복잡도 기준: 0.7" as Worker #FFF4E6
  rectangle "EXPERT · 전문가\nexpert_phd\n동료 연구자·도메인 전문가\n학술 용어·방법론·한계·단순화 지양\n프롬프트 복잡도 기준: 1.0" as Expert #F7EEFF
}
rectangle "Actor: 대상 독자 정책에 따른 재작성\nCritic: 정확성·논리·독자 적합성 평가\n반복 생성·평가 → 사용자 결정 또는 최종 결과" as Output #EAF4EF
Input --> Public
Input --> Student
Input --> Worker
Input --> Expert
Public --> Output
Student --> Output
Worker --> Output
Expert --> Output
legend bottom
  personas.py의 역할·어휘·문장 구성 정책을 요약했습니다. 수치는 프롬프트 기준이며 독해 성과 측정값이 아닙니다.
  전문가 전략은 DIRECT_STRATEGY를 사용합니다. 모든 독자에게 쉬운 문장으로 단순화하는 구조는 아닙니다.
endlegend
@enduml
